{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run TokenCounter",
            "type": "shell",
            "command": "${workspaceFolder}/run.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run TokenCounter (Release)",
            "type": "shell",
            "command": "${workspaceFolder}/run.sh --release",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "swift: Build Debug TokenCounter",
            "type": "shell",
            "command": "swift build",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$swiftc"
        }
    ]
}
